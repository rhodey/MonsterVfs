    "trans2.test",
    "wal8.test"
  ],
  "lenient": [
    "savepoint6.test",
    "savepoint7.test",
    "walcrash.test",
    "walthread.test"
  ],
  "exclusions": {
    "other public scripts": "The broad list holds every other script that passed when last surveyed. Run it with tools/test-sqlite --broad. tools/survey-sqlite finds the rest, most of which ask for settings or file layouts the supported configuration does not have.",
    "rollback-mode persistent databases": "Unsupported after WAL initialization.",
    "non-FULL synchronization": "Outside the supported persistent configuration.",
    "raw main/WAL byte offsets or physical lengths": "Require a logical-I/O adapter for the protected representation.",
    "changing page size": "Protected file geometry is fixed at creation.",
    "SQLite shutdown/reinitialize after application activity": "The VFS maintenance service has terminal shutdown semantics.",
    "durability claims": "Upstream testfixture uses SQLITE_NO_SYNC; use independent real-sync and fault tests.",
    "crash and walcrash scripts": "Written around rollback journals or settings the supported configuration rejects. tools/test-crash models physical power loss through real I/O instead. crash4 runs unchanged, and walcrash runs in the lenient list.",
    "trans.test": "trans-9 asserts that no full sync happened; macOS builds full-sync deliberately.",
    "read-only WAL scripts": "walro and walro2 pass 277 of 300 tests when run without the WAL presql, which would map SHM too early. The other 23 assert physical file sizes. tools/test-readonly compares read-only outcomes with native directly."
  },
  "coverage": {
    "SQL statements": "select1/2/3, insert, and update run through protected WAL storage.",
    "savepoints": "savepoint2 exercises nested savepoints, low-cache writes, rollback signatures, and integrity checks; savepoint5 covers rollback of newly created schema.",
    "shared-cache WAL": "walshared uses two connections and verifies checkpoint rejection during a write transaction, followed by committed visibility and integrity.",
    "crash simulation": "crash4 runs SQLite's crash shim stacked above MonsterVfs.",
    "disk full": "diskfull verifies that a failed write leaves the connection usable.",
    "I/O errors": "ioerr2 and ioerr3 inject failures across transactions, followed by integrity checks.",
    "temporary storage": "tempdb and tempdb2 cover temporary database behavior.",
    "transactions": "trans2 exercises rollback across large transactions.",
    "WAL": "wal8 covers page-size changes on WAL startup.",
    "lenient scripts": "Settings the VFS rejects are absorbed in a test-only build, so that these scripts run at WAL/FULL and 4 KiB: savepoint6 and savepoint7 stress savepoints, walcrash runs crash recovery with the crash shim above the VFS, and walthread races threads."
  },
